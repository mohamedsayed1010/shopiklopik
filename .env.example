# Copy to `.env` (or `.env.production`) and adjust. Vite only exposes
# variables prefixed with VITE_, and it inlines them into the bundle at BUILD
# time — never put a secret here, it ships to the browser in plain text.

# Where the ASP.NET Core API lives. Must be https:// in production: the app is
# served over https, and a plain-http backend would be blocked as mixed
# content, taking the SignalR hub down with it.
#
# The trailing slash is optional — the app normalises it.
#
# Leave this unset to fall back to the current host, which is what the code
# does today (see src/api/axiosInstance.js).
VITE_API_BASE_URL=https://api.shopiklopik.com/

# Where this frontend is served from — used for canonical URLs, Open Graph URLs
# and sitemap.xml. Leave unset and the app falls back to the origin the page is
# loaded from, which is correct at runtime; the sitemap is then skipped entirely,
# because a sitemap needs absolute URLs and an unset domain records none.
VITE_SITE_URL=https://shopiklopik.com
